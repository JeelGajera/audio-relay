<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight became available at API 29. Everything below that keeps the
        Light parent from values/themes.xml; the window background is
        night-aware regardless.
    -->
    <style name="Theme.AudioRelay" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
